# Salin ke .env lalu isi. Jangan pernah commit .env.
PORT=4200

# Kosongkan untuk memakai SQLite lokal (backend/data/sales_roleplay.sqlite).
# Isi kalau mau pakai Postgres; untuk Supabase wajib lewat transaction pooler.
SALES_ROLEPLAY_DATABASE_URL=

# Generate acak, minimal 32 karakter: openssl rand -base64 32
JWT_SECRET=

CORS_ORIGIN=http://localhost:5176

# Tanpa ini, AI service jalan dalam mode mock (respons template, tetap bisa
# dipakai untuk demo alur lengkap tanpa biaya API).
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
